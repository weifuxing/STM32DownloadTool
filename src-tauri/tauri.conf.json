{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "STM32 Download Tool",
  "version": "0.1.3",
  "identifier": "com.stm32.download-tool",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "STM32 ISP Download Tool",
        "width": 1000,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0MkQ5RjI2RTNGOTlDQjUKUldTMW5QbmpKcDh0aEI4V2JIM05LZmxzNC9jN0JEMmNPRExtZFY5SmIyYUtFMFgvV3dWSU56ZWkK",
      "endpoints": [
        "https://github.com/weifuxing/STM32DownloadTool/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}